{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Write",
      "Glob",
      "Bash(ls:*)",
      "Bash(mv:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
